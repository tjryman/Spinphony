# Spotify Developer App credentials
# Create an app at https://developer.spotify.com/dashboard
# Set the Redirect URI to: http://localhost:5173/callback
VITE_SPOTIFY_CLIENT_ID=your_spotify_client_id_here
VITE_SPOTIFY_REDIRECT_URI=http://localhost:5173/callback

# Apple Music Developer Token (JWT)
# Generate at https://developer.apple.com/account/ using your MusicKit key
# Token is valid for up to 6 months
VITE_APPLE_MUSIC_DEV_TOKEN=your_apple_music_developer_token_here
